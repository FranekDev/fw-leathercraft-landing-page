---
interface Props {
  copyrightText: string;
  footerText: string;
}

const { copyrightText, footerText } = Astro.props;
---

<footer class="py-6 md:py-8 text-center border-t border-(--main)/20">
  <div class="space-y-4">
    <p class="text-(--main)/80 text-sm md:text-base">
      © <span id="footer-year">{new Date().getFullYear()}</span>{" "}
      {copyrightText}
    </p>
    <p class="text-(--main)/60 text-xs md:text-sm">
      {footerText}
    </p>
  </div>
</footer>

<script>
  const year = document.getElementById("footer-year");
  if (year) year.textContent = String(new Date().getFullYear());
</script>
